  "cards": [
    {
      "dot": "cyan",
      "title": "Dual-Surface Architecture",
      "items": [
        "Catalog (/) and Academy (/academia/) share domain and brand, zero code coupling",
        "Completely static frontend with independent assets and no build step",
        "Client-side bookmarks and recents persisted in browser localStorage"
      ]
    },
    {
      "dot": "emerald",
      "title": "Catalog & Cloud Integration",
      "items": [
        "Public video catalog queries Sheets metadata dynamically via GViz JSON endpoint",
        "Staff management runs via embedded Google Apps Script web app",
        "Video files stream from Google Drive with metadata synchronized in Sheets"
      ]
    },
    {
      "dot": "violet",
      "title": "Academy & Supabase Hybrid",
      "items": [
        "4 interactive roles: Student, Teacher, Admin, and Guardian (Tutor) with QR passes",
        "Dual persistence: zero-config localStorage demo vs live authenticated Supabase mode",
        "PostgreSQL RLS, transactional RPCs for payments and attendance, and WebMCP isolation"
      ]
    }
  ]
